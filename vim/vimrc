" qlrd vim config (42 / norminette-friendly)

set nocompatible
filetype plugin indent on
syntax on

set number
set relativenumber
" Match helix terminal workflow (avoid accidental mouse edits)
set mouse=
set hidden
set autoread
set autowrite
set updatetime=300

" Keep behavior close to helix defaults
set tabstop=4
set shiftwidth=4
set softtabstop=4
set noexpandtab
set textwidth=80
set colorcolumn=80
set nowrap

" Ensure C files always follow 42 style
augroup qlrd_c_style
  autocmd!
  autocmd FileType c setlocal tabstop=4 shiftwidth=4 softtabstop=4 noexpandtab textwidth=80 colorcolumn=80
augroup END

" Basic plugin setup with vim-plug (optional, if installed)
if exists('*plug#begin')
  call plug#begin('~/.vim/plugged')
  Plug 'dense-analysis/ale'
  Plug 'preservim/nerdcommenter'
  call plug#end()
endif

" ALE: norminette inline diagnostics
let g:ale_linters_explicit = 1
let g:ale_linters = {'c': ['norminette'], 'cpp': []}
let g:ale_c_norminette_executable = '/home/qlrd/.piscinne/bin/norminette'
let g:ale_sign_error = 'E'
let g:ale_sign_warning = 'W'
let g:ale_echo_msg_format = '[norminette] %s'
let g:ale_open_list = 0
let g:ale_set_highlights = 1

" Quick manual norminette check for the current file
command! Norm execute '!norminette ' . shellescape(expand('%:p'))

" 42 header via pipe (mirrors Helix % + :pipe approach — no external file writes)
function! s:Apply42Header()
  execute '%!python3 ~/.config/helix/scripts/42header_pipe.py ' . shellescape(expand('%:p'))
endfunction
nnoremap <silent> <F1> :call <SID>Apply42Header()<CR>
